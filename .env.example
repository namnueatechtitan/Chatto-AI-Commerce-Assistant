NODE_ENV=development
DATABASE_URL=
# Set only from verified existing database credentials. Container URLs use postgres.
POSTGRES_PASSWORD=
ADMIN_DATABASE_URL=
# Requires a verified restricted role; never use the admin URL for the API.
API_DATABASE_URL=
API_PORT=4000
WEB_PORT=3000
AI_SERVICE_PORT=5000
AI_SERVICE_BASE_URL=http://localhost:5000
AI_SERVICE_TOKEN=
AI_SERVICE_TIMEOUT_MS=20000
INTERNAL_SERVICE_TOKEN=
INTERNAL_API_BASE_URL=http://localhost:4000
AI_LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1/interactions
GEMINI_TIMEOUT_MS=10000
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_EMBEDDING_TIMEOUT_MS=10000
OPENAI_MODEL=
JWT_SECRET=
# Local import inputs only. Never forward these credentials into service environments.
# Register through the existing owner-authenticated merchant LINE API after approval.
LINE_OA_A_CHANNEL_ID=2010446906
LINE_OA_A_CHANNEL_SECRET=
LINE_OA_A_CHANNEL_ACCESS_TOKEN=
LINE_OA_B_CHANNEL_ID=2011858511
LINE_OA_B_CHANNEL_SECRET=
LINE_OA_B_CHANNEL_ACCESS_TOKEN=
LINE_CREDENTIAL_KEYRING=
LINE_CREDENTIAL_ACTIVE_KEY_ID=
LINE_CREDENTIAL_VERIFICATION_ENABLED=false
LINE_REPLY_ENABLED=false
LINE_REPLY_TIMEOUT_MS=5000
OPENAI_API_KEY=phase-2-placeholder-key
CHECKPOINT_DISABLE=1

# LINE Login channel credentials (separate from merchant Messaging API import inputs)
WEB_URL=http://localhost:3000
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/line/callback
