# Deployment template only. Do not use this file as a ready-to-run configuration.
# Provision actual values through the approved private deployment mechanism.
# A local filled copy must end in .private.env (ignored by Git and Docker).
# Preserve the existing database password, auth settings, provider settings,
# decrypting key versions and active service credentials until an approved change.
POSTGRES_PASSWORD=
ADMIN_DATABASE_URL=
API_DATABASE_URL=
AI_SERVICE_TOKEN=
INTERNAL_SERVICE_TOKEN=
LINE_CREDENTIAL_KEYRING=
LINE_CREDENTIAL_ACTIVE_KEY_ID=

# Set only after approval of live provider verification and replies.
LINE_CREDENTIAL_VERIFICATION_ENABLED=false
LINE_REPLY_ENABLED=false
LINE_PUBLIC_WEBHOOK_URL=

# The deployed browser origin and exact existing OAuth callback settings.
WEB_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=
JWT_SECRET=

# Set explicitly to the existing approved provider; an empty setting defaults
# to mock in Compose. Preserve existing provider keys, models and timeouts.
AI_LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_API_BASE_URL=
GEMINI_TIMEOUT_MS=
GEMINI_EMBEDDING_MODEL=
GEMINI_EMBEDDING_DIMENSIONS=
GEMINI_EMBEDDING_TIMEOUT_MS=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_SERVICE_TIMEOUT_MS=

# Keep empty; this rollout does not approve scaffold compatibility changes.
SCAFFOLD_501_APPROVED_ROUTES=
