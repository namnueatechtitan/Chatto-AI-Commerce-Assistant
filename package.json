{
  "name": "chatto-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @chatto/web --filter @chatto/api --filter @chatto/ai-service dev",
    "dev:web": "pnpm --filter @chatto/web dev",
    "dev:api": "pnpm --filter @chatto/api dev",
    "dev:ai-service": "pnpm --filter @chatto/ai-service dev",
    "build": "pnpm --filter @chatto/shared build && pnpm --filter @chatto/config build && pnpm --filter @chatto/api build && pnpm --filter @chatto/ai-service build && pnpm --filter @chatto/web build",
    "prisma:generate": "pnpm --filter @chatto/api prisma generate",
    "prisma:migrate": "pnpm --filter @chatto/api prisma migrate dev --name phase-2-foundation"
  }
}
