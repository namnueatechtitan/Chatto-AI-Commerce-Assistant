// หน้าที่ไฟล์: ไฟล์นี้ประกาศโครงสร้างฐานข้อมูลหลักของโปรเจกต์ใน Phase 2 ด้วย Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE    @map("active")
  INACTIVE  @map("inactive")
  SUSPENDED @map("suspended")
  DELETED   @map("deleted")
}

enum MerchantStatus {
  ACTIVE    @map("active")
  INACTIVE  @map("inactive")
  SUSPENDED @map("suspended")
  TRIAL     @map("trial")
}

enum ChannelStatus {
  CONNECTED     @map("connected")
  DISCONNECTED  @map("disconnected")
  INVALID_TOKEN @map("invalid_token")
  DISABLED      @map("disabled")
}

enum ProductStatus {
  DRAFT    @map("draft")
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  ARCHIVED @map("archived")
}

enum DocumentStatus {
  ACTIVE   @map("active")
  INACTIVE @map("inactive")
  ARCHIVED @map("archived")
  OUTDATED @map("outdated")
}

enum ConversationStatus {
  AI_ACTIVE          @map("ai_active")
  HANDOVER_REQUESTED @map("handover_requested")
  HUMAN_ACTIVE       @map("human_active")
  RESOLVED           @map("resolved")
  CLOSED             @map("closed")
}

enum SenderType {
  CUSTOMER    @map("customer")
  AI          @map("ai")
  HUMAN_AGENT @map("human_agent")
  SYSTEM      @map("system")
}

enum MessageType {
  TEXT          @map("text")
  IMAGE         @map("image")
  STICKER       @map("sticker")
  PRODUCT_CARD  @map("product_card")
  ORDER_SUMMARY @map("order_summary")
  PAYMENT_QR    @map("payment_qr")
  SYSTEM_EVENT  @map("system_event")
}

enum TicketStatus {
  OPEN        @map("open")
  ASSIGNED    @map("assigned")
  IN_PROGRESS @map("in_progress")
  RESOLVED    @map("resolved")
  CLOSED      @map("closed")
}

enum TicketPriority {
  LOW    @map("low")
  MEDIUM @map("medium")
  HIGH   @map("high")
  URGENT @map("urgent")
}

enum AiActionStatus {
  PROPOSED              @map("proposed")
  VALIDATED             @map("validated")
  REJECTED              @map("rejected")
  EXECUTED              @map("executed")
  HUMAN_REVIEW_REQUIRED @map("human_review_required")
  FAILED                @map("failed")
}

enum GuardrailSeverity {
  LOW      @map("low")
  MEDIUM   @map("medium")
  HIGH     @map("high")
  CRITICAL @map("critical")
}

model User {
  id                            String               @id @default(uuid()) @db.Uuid
  name                          String               @db.VarChar(255)
  email                         String               @unique @db.VarChar(255)
  passwordHash                  String               @map("password_hash") @db.VarChar(255)
  globalRole                    String               @map("global_role") @db.VarChar(50)
  status                        UserStatus           @default(ACTIVE)
  merchantUsers                 MerchantUser[]
  handoverMessagesSent          HandoverMessage[]    @relation("HandoverMessageSenderUser")
  assignedChattoAdminTickets    HandoverTicket[]     @relation("HandoverTicketAssignedChattoAdmin")
  assignedAgentHandoverHistory  HandoverAssignment[] @relation("HandoverAssignmentAssignedAgent")
  assignedByHandoverHistory     HandoverAssignment[] @relation("HandoverAssignmentAssignedBy")
  createdAt                     DateTime             @default(now()) @map("created_at")
  updatedAt                     DateTime             @updatedAt @map("updated_at")

  @@map("users")
}

model Merchant {
  id                     String                  @id @default(uuid()) @db.Uuid
  shopName               String                  @map("shop_name") @db.VarChar(255)
  slug                   String                  @unique @db.VarChar(255)
  businessCategory       String?                 @map("business_category") @db.VarChar(255)
  status                 MerchantStatus          @default(TRIAL)
  merchantUsers          MerchantUser[]
  channels               Channel[]
  lineWebhookEvents      LineWebhookEvent[]
  products               Product[]
  productVariants        ProductVariant[]
  productImages          ProductImage[]
  knowledgeBaseDocuments KnowledgeBaseDocument[]
  vectorDocuments        VectorDocument[]
  customers              Customer[]
  conversations          Conversation[]
  messages               Message[]
  aiSettings             AiSetting[]
  aiActionLogs           AiActionLog[]
  guardrailEvents        GuardrailEvent[]
  customerMemories       CustomerMemory[]
  handoverTickets        HandoverTicket[]
  handoverMessages       HandoverMessage[]
  handoverAssignments    HandoverAssignment[]
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  @@map("merchants")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(100)
  description     String?          @db.Text
  status          String           @db.VarChar(50)
  merchantUsers   MerchantUser[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(150)
  description     String?          @db.Text
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid @map("role_id")
  permissionId String     @db.Uuid @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model MerchantUser {
  id              String          @id @default(uuid()) @db.Uuid
  merchantId      String          @db.Uuid @map("merchant_id")
  userId          String          @db.Uuid @map("user_id")
  roleId          String          @db.Uuid @map("role_id")
  customPermissions Json?         @map("custom_permissions")
  status          UserStatus      @default(ACTIVE)
  merchant        Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedTickets HandoverTicket[] @relation("HandoverTicketAssignedMerchantUser")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@unique([merchantId, userId])
  @@index([merchantId])
  @@index([userId])
  @@index([roleId])
  @@map("merchant_users")
}

model Platform {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(100)
  status    String    @db.VarChar(50)
  channels  Channel[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("platforms")
}

model Channel {
  id                    String        @id @default(uuid()) @db.Uuid
  merchantId            String        @db.Uuid @map("merchant_id")
  platformId            String        @db.Uuid @map("platform_id")
  channelName           String        @map("channel_name") @db.VarChar(255)
  externalChannelId     String?       @map("external_channel_id") @db.VarChar(255)
  accessTokenEncrypted  String?       @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted String?       @map("refresh_token_encrypted") @db.Text
  channelSecretEncrypted String?      @map("channel_secret_encrypted") @db.Text
  webhookUrl            String?       @map("webhook_url") @db.Text
  isConnected           Boolean       @default(false) @map("is_connected")
  status                ChannelStatus @default(DISCONNECTED)
  merchant              Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  platform              Platform      @relation(fields: [platformId], references: [id], onDelete: Restrict)
  lineWebhookEvents     LineWebhookEvent[]
  customers             Customer[]
  conversations         Conversation[]
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@unique([merchantId, platformId, externalChannelId])
  @@index([merchantId])
  @@index([platformId])
  @@index([externalChannelId])
  @@map("channels")
}

model LineWebhookEvent {
  id             String    @id @default(uuid()) @db.Uuid
  merchantId     String    @db.Uuid @map("merchant_id")
  channelId      String    @db.Uuid @map("channel_id")
  webhookEventId String    @unique @map("webhook_event_id") @db.VarChar(255)
  eventType      String    @map("event_type") @db.VarChar(100)
  rawPayload     Json      @map("raw_payload")
  isDuplicate    Boolean   @default(false) @map("is_duplicate")
  processedAt    DateTime? @map("processed_at")
  merchant       Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  channel        Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([merchantId])
  @@index([channelId])
  @@map("line_webhook_events")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  merchantId  String        @db.Uuid @map("merchant_id")
  name        String        @db.VarChar(255)
  description String?       @db.Text
  category    String?       @db.VarChar(255)
  brand       String?       @db.VarChar(255)
  status      ProductStatus @default(DRAFT)
  merchant    Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
  images      ProductImage[]
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([merchantId])
  @@map("products")
}

model ProductVariant {
  id                String        @id @default(uuid()) @db.Uuid
  merchantId        String        @db.Uuid @map("merchant_id")
  productId         String        @db.Uuid @map("product_id")
  variantName       String        @map("variant_name") @db.VarChar(255)
  sku               String?       @db.VarChar(100)
  color             String?       @db.VarChar(100)
  size              String?       @db.VarChar(100)
  price             Decimal?      @db.Decimal(12, 2)
  currency          String?       @db.VarChar(10)
  stockOnHand       Int?          @map("stock_on_hand")
  stockReserved     Int?          @map("stock_reserved")
  lowStockThreshold Int?          @map("low_stock_threshold")
  status            ProductStatus @default(DRAFT)
  merchant          Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([merchantId])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @db.Uuid @map("merchant_id")
  productId  String   @db.Uuid @map("product_id")
  imageUrl   String   @map("image_url") @db.Text
  altText    String?  @map("alt_text") @db.VarChar(255)
  sortOrder  Int      @default(0) @map("sort_order")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([merchantId])
  @@index([productId])
  @@map("product_images")
}

model KnowledgeBaseDocument {
  id         String         @id @default(uuid()) @db.Uuid
  merchantId String         @db.Uuid @map("merchant_id")
  type       String         @db.VarChar(100)
  title      String         @db.VarChar(255)
  content    String         @db.Text
  status     DocumentStatus @default(ACTIVE)
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([merchantId])
  @@map("knowledge_base_documents")
}

model VectorDocument {
  id         String         @id @default(uuid()) @db.Uuid
  merchantId String         @db.Uuid @map("merchant_id")
  sourceType String         @map("source_type") @db.VarChar(100)
  sourceId   String         @map("source_id") @db.Uuid
  chunkText  String         @map("chunk_text") @db.Text
  /// TODO: Replace Json embedding with pgvector in production.
  embedding  Json?
  metadata   Json?
  status     DocumentStatus @default(ACTIVE)
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([merchantId])
  @@index([sourceId])
  @@index([sourceType])
  @@map("vector_documents")
}

model Customer {
  id                 String            @id @default(uuid()) @db.Uuid
  merchantId         String            @db.Uuid @map("merchant_id")
  channelId          String            @db.Uuid @map("channel_id")
  externalUserId     String            @map("external_user_id") @db.VarChar(255)
  displayName        String?           @map("display_name") @db.VarChar(255)
  phone              String?           @db.VarChar(50)
  email              String?           @db.VarChar(255)
  profilePictureUrl  String?           @map("profile_picture_url") @db.Text
  isBlocked          Boolean           @default(false) @map("is_blocked")
  blockedReason      String?           @map("blocked_reason") @db.Text
  merchant           Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  channel            Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  aiActionLogs       AiActionLog[]
  guardrailEvents    GuardrailEvent[]
  customerMemories   CustomerMemory[]
  handoverTickets    HandoverTicket[]
  handoverMessagesSent HandoverMessage[] @relation("HandoverMessageSenderCustomer")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  @@unique([channelId, externalUserId])
  @@index([merchantId])
  @@index([channelId])
  @@index([externalUserId])
  @@index([email])
  @@map("customers")
}

model Conversation {
  id              String             @id @default(uuid()) @db.Uuid
  merchantId      String             @db.Uuid @map("merchant_id")
  customerId      String             @db.Uuid @map("customer_id")
  channelId       String             @db.Uuid @map("channel_id")
  status          ConversationStatus @default(AI_ACTIVE)
  ownerType       String?            @map("owner_type") @db.VarChar(50)
  assignedStaffId String?            @db.Uuid @map("assigned_staff_id")
  lastMessageAt   DateTime?          @map("last_message_at")
  merchant        Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer        Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channel         Channel            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  messages        Message[]
  aiActionLogs    AiActionLog[]
  guardrailEvents GuardrailEvent[]
  sourceMemories  CustomerMemory[]   @relation("CustomerMemorySourceConversation")
  handoverTickets HandoverTicket[]
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([merchantId])
  @@index([customerId])
  @@index([channelId])
  @@index([assignedStaffId])
  @@map("conversations")
}

model Message {
  id                String       @id @default(uuid()) @db.Uuid
  merchantId        String       @db.Uuid @map("merchant_id")
  conversationId    String       @db.Uuid @map("conversation_id")
  senderType        SenderType   @map("sender_type")
  senderId          String?      @db.Uuid @map("sender_id")
  messageType       MessageType  @map("message_type")
  content           String       @db.Text
  metadata          Json?
  externalMessageId String?      @map("external_message_id") @db.VarChar(255)
  merchant          Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([merchantId])
  @@index([conversationId])
  @@index([externalMessageId])
  @@index([senderId])
  @@map("messages")
}

model AiSetting {
  id                     String    @id @default(uuid()) @db.Uuid
  merchantId             String    @db.Uuid @map("merchant_id")
  botName                String    @map("bot_name") @db.VarChar(100)
  language               String    @db.VarChar(20)
  tone                   String?   @db.VarChar(100)
  formality              String?   @db.VarChar(100)
  handoverThreshold      Decimal?  @map("handover_threshold") @db.Decimal(5, 4)
  maxRecommendedProducts Int?      @map("max_recommended_products")
  memoryEnabled          Boolean?  @map("memory_enabled")
  allowedTopics          Json?     @map("allowed_topics")
  forbiddenActions       Json?     @map("forbidden_actions")
  storeRules             Json?     @map("store_rules")
  merchant               Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@unique([merchantId])
  @@index([merchantId])
  @@map("ai_settings")
}

model PromptVersion {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @db.VarChar(255)
  version      String        @db.VarChar(50)
  content      String        @db.Text
  status       String        @db.VarChar(50)
  aiActionLogs AiActionLog[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([name, version])
  @@map("prompt_versions")
}

model AiActionLog {
  id               String         @id @default(uuid()) @db.Uuid
  merchantId       String         @db.Uuid @map("merchant_id")
  conversationId   String?        @db.Uuid @map("conversation_id")
  customerId       String?        @db.Uuid @map("customer_id")
  actionType       String         @map("action_type") @db.VarChar(100)
  status           AiActionStatus @default(PROPOSED)
  confidence       Decimal?       @db.Decimal(5, 4)
  inputJson        Json?          @map("input_json")
  outputJson       Json?          @map("output_json")
  validationResult Json?          @map("validation_result")
  reason           String?        @db.Text
  promptVersionId  String?        @db.Uuid @map("prompt_version_id")
  merchant         Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  conversation     Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customer         Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  promptVersion    PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([merchantId])
  @@index([conversationId])
  @@index([customerId])
  @@index([promptVersionId])
  @@map("ai_action_logs")
}

model GuardrailEvent {
  id              String            @id @default(uuid()) @db.Uuid
  merchantId      String            @db.Uuid @map("merchant_id")
  conversationId  String?           @db.Uuid @map("conversation_id")
  customerId      String?           @db.Uuid @map("customer_id")
  eventType       String            @map("event_type") @db.VarChar(100)
  severity        GuardrailSeverity @default(LOW)
  customerMessage String?           @map("customer_message") @db.Text
  blockedAction   String?           @map("blocked_action") @db.VarChar(100)
  aiReply         String?           @map("ai_reply") @db.Text
  description     String?           @db.Text
  merchant        Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  conversation    Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  customer        Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([merchantId])
  @@index([conversationId])
  @@index([customerId])
  @@map("guardrail_events")
}

model CustomerMemory {
  id                   String        @id @default(uuid()) @db.Uuid
  merchantId           String        @db.Uuid @map("merchant_id")
  customerId           String        @db.Uuid @map("customer_id")
  memoryType           String        @map("memory_type") @db.VarChar(100)
  key                  String        @db.VarChar(150)
  value                String        @db.Text
  confidence           Decimal?      @db.Decimal(5, 4)
  sourceConversationId String?       @db.Uuid @map("source_conversation_id")
  lastUsedAt           DateTime?     @map("last_used_at")
  merchant             Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer             Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourceConversation   Conversation? @relation("CustomerMemorySourceConversation", fields: [sourceConversationId], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@index([merchantId])
  @@index([customerId])
  @@index([sourceConversationId])
  @@index([customerId, key])
  @@map("customer_memories")
}

model HandoverTicket {
  id                    String          @id @default(uuid()) @db.Uuid
  merchantId            String          @db.Uuid @map("merchant_id")
  conversationId        String          @db.Uuid @map("conversation_id")
  customerId            String          @db.Uuid @map("customer_id")
  reason                String          @db.VarChar(100)
  priority              TicketPriority  @default(MEDIUM)
  status                TicketStatus    @default(OPEN)
  aiSummary             String?         @map("ai_summary") @db.Text
  assignedMerchantUserId String?        @db.Uuid @map("assigned_merchant_user_id")
  assignedChattoAdminId String?         @db.Uuid @map("assigned_chatto_admin_id")
  merchant              Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  conversation          Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer              Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignedMerchantUser  MerchantUser?   @relation("HandoverTicketAssignedMerchantUser", fields: [assignedMerchantUserId], references: [id], onDelete: SetNull)
  assignedChattoAdmin   User?           @relation("HandoverTicketAssignedChattoAdmin", fields: [assignedChattoAdminId], references: [id], onDelete: SetNull)
  messages              HandoverMessage[]
  assignments           HandoverAssignment[]
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  @@index([merchantId])
  @@index([conversationId])
  @@index([customerId])
  @@index([assignedMerchantUserId])
  @@index([assignedChattoAdminId])
  @@map("handover_tickets")
}

model HandoverMessage {
  id               String         @id @default(uuid()) @db.Uuid
  merchantId       String         @db.Uuid @map("merchant_id")
  ticketId         String         @db.Uuid @map("ticket_id")
  senderType       SenderType     @map("sender_type")
  senderUserId     String?        @db.Uuid @map("sender_user_id")
  senderCustomerId String?        @db.Uuid @map("sender_customer_id")
  message          String         @db.Text
  merchant         Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  ticket           HandoverTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderUser       User?          @relation("HandoverMessageSenderUser", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderCustomer   Customer?      @relation("HandoverMessageSenderCustomer", fields: [senderCustomerId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([merchantId])
  @@index([ticketId])
  @@index([senderUserId])
  @@index([senderCustomerId])
  @@map("handover_messages")
}

model HandoverAssignment {
  id              String         @id @default(uuid()) @db.Uuid
  merchantId      String         @db.Uuid @map("merchant_id")
  ticketId        String         @db.Uuid @map("ticket_id")
  assignedAgentId String?        @db.Uuid @map("assigned_agent_id")
  assignedById    String?        @db.Uuid @map("assigned_by_id")
  assignedAt      DateTime       @default(now()) @map("assigned_at")
  status          String         @db.VarChar(50)
  merchant        Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  ticket          HandoverTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignedAgent   User?          @relation("HandoverAssignmentAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
  assignedBy      User?          @relation("HandoverAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([ticketId])
  @@index([assignedAgentId])
  @@index([assignedById])
  @@map("handover_assignments")
}
